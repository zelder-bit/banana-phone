{
  "name": "banana-phone",
  "version": "0.4.0",
  "description": "A fruity remote desktop and terminal connection manager",
  "main": "main.js",
  "license": "MIT",
  "author": "banana-phone",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --linux AppImage --publish never",
    "check:walkthrough": "node scripts/check-walkthrough.js",
    "test:ui": "node --test scripts/ui.e2e.js",
    "test:share": "node --test --test-force-exit scripts/share.itest.js",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron guacd.test.js"
  },
  "build": {
    "appId": "dev.fruit.banana-phone",
    "productName": "banana-phone",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "guacd.js",
      "share.js",
      "renderer/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "build/icon.png",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "guacamole-common-js": "^1.5.0",
    "guacamole-lite": "^1.2.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2": false,
    "electron-winstaller": false,
    "cpu-features@0.0.10": true
  },
  "desktopName": "banana-phone.desktop"
}
