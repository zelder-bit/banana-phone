{
  "name": "banana-phone",
  "version": "0.1.0",
  "description": "A fruity remote desktop and terminal connection manager",
  "main": "main.js",
  "license": "MIT",
  "author": "banana-phone",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --linux AppImage",
    "check:walkthrough": "node scripts/check-walkthrough.js"
  },
  "build": {
    "appId": "dev.fruit.banana-phone",
    "productName": "banana-phone",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "guacd.js",
      "renderer/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "build/icon.png",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "guacamole-common-js": "^1.5.0",
    "guacamole-lite": "^1.2.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "cpu-features": false,
    "ssh2": false,
    "electron-winstaller": false
  },
  "desktopName": "banana-phone.desktop"
}
